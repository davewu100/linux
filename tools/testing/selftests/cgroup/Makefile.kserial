# Makefile for k-serial userspace tools
# 
# Usage:
#   make -f Makefile.kserial          # Build all
#   make -f Makefile.kserial clean    # Clean
#   make -f Makefile.kserial test     # Run tests

CC = gcc
CFLAGS = -Wall -Wextra -O2
LDFLAGS =

# Targets
TARGETS = test_kserial_real test_kserial_security test_memcg_query example_monitor

all: $(TARGETS)

# Main test program (requires kernel module)
test_kserial_real: test_kserial_real.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Security test (overflow and bounds checking)
test_kserial_security: test_kserial_security.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# mem_cgroup query test
test_memcg_query: test_memcg_query.c
	$(CC) $(CFLAGS) -o $@ $< $(LDFLAGS)

# Make Python client executable
python-client:
	chmod +x kserial_with_pid.py

# Install (copy to /usr/local/bin)
install: all python-client
	install -m 755 test_kserial_real /usr/local/bin/kserial-query
	install -m 755 kserial_with_pid.py /usr/local/bin/kserial-query-py

# Tests
test: test_kserial_real
	@echo "=== Running k-serial tests ==="
	@echo ""
	@echo "Test 1: Single field"
	sudo ./test_kserial_real level
	@echo ""
	@echo "Test 2: Multiple fields"
	sudo ./test_kserial_real level nr_descendants
	@echo ""
	@echo "Test 3: All whitelisted fields"
	sudo ./test_kserial_real level max_depth nr_descendants nr_dying_descendants max_descendants
	@echo ""
	@echo "=== All tests passed ==="

# Clean
clean:
	rm -f $(TARGETS) *.o

.PHONY: all clean test install python-client
