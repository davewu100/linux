menu "zcomp compressor backends"
	depends on ZRAM || SWAP_COMPRESS

config ZCOMP_BACKEND_LZ4
	bool "lz4 compression support"
	depends on ZRAM || SWAP_COMPRESS
	select LZ4_COMPRESS
	select LZ4_DECOMPRESS

config ZCOMP_BACKEND_LZ4HC
	bool "lz4hc compression support"
	depends on ZRAM || SWAP_COMPRESS
	select LZ4HC_COMPRESS
	select LZ4_DECOMPRESS

config ZCOMP_BACKEND_ZSTD
	bool "zstd compression support"
	depends on ZRAM || SWAP_COMPRESS
	select ZSTD_COMPRESS
	select ZSTD_DECOMPRESS

config ZCOMP_BACKEND_DEFLATE
	bool "deflate compression support"
	depends on ZRAM || SWAP_COMPRESS
	select ZLIB_DEFLATE
	select ZLIB_INFLATE

config ZCOMP_BACKEND_842
	bool "842 compression support"
	depends on ZRAM || SWAP_COMPRESS
	select 842_COMPRESS
	select 842_DECOMPRESS

config ZCOMP_BACKEND_FORCE_LZO
	depends on ZRAM || SWAP_COMPRESS
	def_bool !ZCOMP_BACKEND_LZ4 && !ZCOMP_BACKEND_LZ4HC && \
		!ZCOMP_BACKEND_ZSTD && !ZCOMP_BACKEND_DEFLATE && \
		!ZCOMP_BACKEND_842

config ZCOMP_BACKEND_LZO
	bool "lzo and lzo-rle compression support" if !ZCOMP_BACKEND_FORCE_LZO
	depends on ZRAM || SWAP_COMPRESS
	default ZCOMP_BACKEND_FORCE_LZO
	select LZO_COMPRESS
	select LZO_DECOMPRESS

endmenu
