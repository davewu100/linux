  <diagram id="shmem-undo-range" name="shmem_undo_range">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="Entry&#xa;shmem_undo_range(inode, lstart, lend, unfalloc)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="340" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="Normalize range&#xa;start = ceil(lstart/PAGE_SIZE)&#xa;end = ceil((lend+1)/PAGE_SIZE)&#xa;if lend == -1, end = -1&#xa;update info-&gt;fallocend for non-unfalloc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="4" value="Loop 1&#xa;find_lock_entries(mapping, &amp;index, end-1, ...)&#xa;Only fully covered entries&#xa;Folios come back locked&#xa;Busy/writeback/partial large folios are skipped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="510" y="250" width="440" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="5" value="Entry is swap/XArray value?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="6" value="If !unfalloc:&#xa;shmem_free_swap(indices[i], end-1, value)&#xa;accumulate nr_swaps_freed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="270" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="7" value="Normal folio path&#xa;if !unfalloc || !folio_uptodate&#xa;  truncate_inode_folio()&#xa;unlock folio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="520" width="280" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="8" value="unfalloc?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="650" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="9" value="Skip partial-boundary handling&#xa;go directly to whole_folios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="900" y="760" width="250" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="Boundary handling for !unfalloc&#xa;Fetch start partial folio with shmem_get_partial_folio()&#xa;truncate_inode_partial_folio(lstart, lend)&#xa;adjust start/end&#xa;Then maybe do same for end partial folio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="760" width="420" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="Loop 2: whole_folios&#xa;while (index &lt; end)&#xa;  find_get_entries(...)&#xa;Get refs only, then lock one by one&#xa;Cleans up leftovers, retries races, handles large folios and swap edge cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="430" y="900" width="500" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="No entries found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="600" y="1040" width="170" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="Break if hole-punch/unfalloc&#xa;or restart from start if full truncate and gaps/races remain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="270" y="1160" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="Per-entry handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="860" y="1160" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="Swap entry?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="885" y="1260" width="130" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="Try shmem_free_swap()&#xa;if failed, confirm order with shmem_confirm_swap()&#xa;retry from base on race/extension&#xa;skip large swap crossing boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1250" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="Lock folio&#xa;verify mapping unchanged&#xa;if small folio: truncate_inode_folio()&#xa;if large folio: truncate_inode_partial_folio()&#xa;if split happened, restart scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
